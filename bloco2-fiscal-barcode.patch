@@ -0,0 +1,155 @@
+"""
+inventory/barcode.py — leitura de código de barras no PDV.
+
+Dois mundos convivem no mesmo leitor:
+
+1. **GTIN global** (EAN-13, EAN-8, GTIN-14, UPC-A). Identifica o produto no
+   mundo inteiro. É o que o Cosmos/Bluesoft resolve.
+
+2. **Etiqueta de balança** — prefixos 20–29, reservados pela GS1 para
+   circulação interna da loja. Aqui o código NÃO identifica um produto
+   global: parte dos dígitos carrega o PLU e parte carrega o PESO ou o
+   PREÇO calculado na balança.
+
+⚠️ POR QUE ISSO É BLOQUEANTE
+Sem tratar o prefixo de balança, o sistema simplesmente não funciona em
+açougue, padaria e hortifruti: cada etiqueta gerada é um código diferente,
+então o lookup no catálogo global sempre falha e a venda trava. É pouco
+código, mas é a diferença entre atender ou não metade dos mercadinhos de
+bairro.
+
+⚠️ O LAYOUT DA BALANÇA É CONFIGURÁVEL POR LOJA
+Não existe padrão nacional único: Toledo, Filizola e Urano são
+configuráveis, e cada loja escolhe se a etiqueta carrega peso ou preço.
+Por isso o layout é parâmetro, não constante. O default abaixo é o arranjo
+mais comum (prefixo + 5 de PLU + 5 de valor + verificador).
+"""
+from dataclasses import dataclass
+from decimal import Decimal
+from typing import Optional
+
+# Prefixos GS1 de circulação restrita — nunca consulte catálogo global com eles.
+PREFIXOS_INTERNOS = tuple(str(n) for n in range(20, 30))
+
+
+class TipoCodigo:
+    GTIN = 'gtin'
+    BALANCA_PESO = 'balanca_peso'
+    BALANCA_PRECO = 'balanca_preco'
+    DESCONHECIDO = 'desconhecido'
+
+
+@dataclass
+class LeituraCodigo:
+    """Resultado da leitura. `raw` é sempre preservado para auditoria."""
+    raw: str
+    tipo: str
+    gtin: Optional[str] = None
+    plu: Optional[int] = None
+    peso_kg: Optional[Decimal] = None
+    preco: Optional[Decimal] = None
+    valido: bool = False
+    erro: str = ''
+
+    @property
+    def precisa_catalogo_global(self) -> bool:
+        """Só GTIN vale consulta externa. Etiqueta de balança é local."""
+        return self.tipo == TipoCodigo.GTIN and self.valido
+
+
+def digito_verificador(codigo_sem_dv: str) -> int:
+    """
+    Dígito verificador GS1 (módulo 10).
+
+    Pesos 3 e 1 alternados, da direita para a esquerda. Vale para EAN-8,
+    EAN-13, UPC-A e GTIN-14 — a regra é a mesma, muda só o comprimento.
+    """
+    soma = 0
+    for i, ch in enumerate(reversed(codigo_sem_dv)):
+        peso = 3 if i % 2 == 0 else 1
+        soma += int(ch) * peso
+    return (10 - (soma % 10)) % 10
+
+
+def gtin_valido(codigo: str) -> bool:
+    """Confere o dígito verificador. Pega erro de digitação e leitura suja."""
+    if not codigo or not codigo.isdigit():
+        return False
+    if len(codigo) not in (8, 12, 13, 14):
+        return False
+    return digito_verificador(codigo[:-1]) == int(codigo[-1])
+
+
+def parse(
+    codigo: str,
+    *,
+    digitos_plu: int = 5,
+    digitos_valor: int = 5,
+    modo: str = 'peso',
+    casas_peso: int = 3,
+) -> LeituraCodigo:
+    """
+    Interpreta o que o leitor entregou.
+
+    Args:
+        codigo: os dígitos lidos.
+        digitos_plu: quantos dígitos identificam o produto na etiqueta.
+        digitos_valor: quantos dígitos carregam peso ou preço.
+        modo: 'peso' (etiqueta traz kg) ou 'preco' (etiqueta traz R$).
+        casas_peso: casas decimais do peso. 3 = gramas (12345 → 12,345 kg).
+
+    O layout vem da configuração da unidade, não daqui.
+    """
+    limpo = ''.join(c for c in (codigo or '') if c.isdigit())
+
+    if not limpo:
+        return LeituraCodigo(raw=codigo or '', tipo=TipoCodigo.DESCONHECIDO,
+                             erro='Código vazio.')
+
+    # ── Etiqueta de balança ────────────────────────────────────────────
+    if len(limpo) == 13 and limpo[:2] in PREFIXOS_INTERNOS:
+        esperado = 2 + digitos_plu + digitos_valor + 1
+        if esperado != 13:
+            return LeituraCodigo(
+                raw=limpo, tipo=TipoCodigo.DESCONHECIDO,
+                erro=f'Layout de balança inconsistente: soma {esperado} dígitos, esperado 13.'
+            )
+
+        ini_valor = 2 + digitos_plu
+        plu = int(limpo[2:ini_valor])
+        bruto = int(limpo[ini_valor:ini_valor + digitos_valor])
+
+        # ⚠️ O DV da etiqueta é conferido, mas o dígito interno de peso que
+        # algumas balanças inserem NÃO é tratado aqui — se a sua balança usa
+        # esse arranjo, ajuste digitos_valor na configuração da unidade.
+        ok = digito_verificador(limpo[:-1]) == int(limpo[-1])
+
+        if modo == 'preco':
+            return LeituraCodigo(
+                raw=limpo, tipo=TipoCodigo.BALANCA_PRECO, plu=plu,
+                preco=Decimal(bruto) / Decimal(100),
+                valido=ok, erro='' if ok else 'Dígito verificador não confere.',
+            )
+
+        return LeituraCodigo(
+            raw=limpo, tipo=TipoCodigo.BALANCA_PESO, plu=plu,
+            peso_kg=Decimal(bruto) / (Decimal(10) ** casas_peso),
+            valido=ok, erro='' if ok else 'Dígito verificador não confere.',
+        )
+
+    # ── GTIN global ────────────────────────────────────────────────────
+    if len(limpo) in (8, 12, 13, 14):
+        ok = gtin_valido(limpo)
+        # UPC-A (12) vira EAN-13 com zero à esquerda: o mesmo produto não
+        # pode existir duas vezes no catálogo por causa disso.
+        normalizado = limpo.zfill(13) if len(limpo) == 12 else limpo
+        return LeituraCodigo(
+            raw=limpo, tipo=TipoCodigo.GTIN,
+            gtin=normalizado if ok else None,
+            valido=ok, erro='' if ok else 'Dígito verificador não confere.',
+        )
+
+    return LeituraCodigo(
+        raw=limpo, tipo=TipoCodigo.DESCONHECIDO,
+        erro=f'Comprimento não reconhecido ({len(limpo)} dígitos).',
+    )
