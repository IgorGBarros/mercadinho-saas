+# .env.example — copie para backend/core/.env e ajuste.
+# ⚠️ O .env real NUNCA entra no Git. Confira o .gitignore.
+
+# ── Django ────────────────────────────────────────────────────────────
+SECRET_KEY=troque-isto-por-algo-longo-e-aleatorio
+DEBUG=True
+ALLOWED_HOSTS=localhost,127.0.0.1
+
+# ── Banco ─────────────────────────────────────────────────────────────
+# Local, via docker-compose.dev.yml:
+DATABASE_URL=postgres://mercadinho:dev-local-only@localhost:5432/mercadinho
+#
+# Supabase, quando for para produção. Django é um servidor PERSISTENTE, não
+# serverless — então a conexão direta (5432) é a que faz sentido, não o
+# pooler em transaction mode (6543), que existe para clientes efêmeros.
+#
+#   DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
+#
+# Se por algum motivo você PRECISAR do pooler em transaction mode (6543),
+# duas coisas obrigatórias no settings, senão quebra em produção com erro
+# que não faz sentido nenhum:
+#
+#   DATABASES['default']['DISABLE_SERVER_SIDE_CURSORS'] = True
+#   DATABASES['default']['CONN_MAX_AGE'] = 0
+#
+# Server-side cursors não funcionam sob transaction pooling, e conexão
+# persistente não ajuda quando o pooler recicla a conexão a cada transação.
+
+# ── Cache ─────────────────────────────────────────────────────────────
+REDIS_URL=redis://localhost:6379/0
+
+# ── Pagamento ─────────────────────────────────────────────────────────
+ASAAS_API_KEY=
+ASAAS_ENV=sandbox
+
+# ── Fiscal (Etapa 4) ──────────────────────────────────────────────────
+# ⚠️ O certificado A1 (.pfx) e o CSC pertencem ao CNPJ do CLIENTE, não ao
+# seu. Ficam criptografados no banco (tenancy.Operator), nunca em arquivo
+# no repositório. Aqui vai só a chave do hub e a chave de criptografia.
+FOCUS_NFE_TOKEN=
+FOCUS_NFE_AMBIENTE=homologacao
+FISCAL_ENCRYPTION_KEY=
+
+# ── Admin ─────────────────────────────────────────────────────────────
+ADMIN_EMAILS=voce@exemplo.com
+TRIAL_DAYS=14
